# Copy to .env (gitignored) and fill in. docker-compose reads this file automatically.

# Login for the whole dashboard (HTTP Basic Auth, enforced on every route).
DASHBOARD_USERNAME=admin

# A bcrypt hash of the password — never the plaintext. Generate one with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'your-password-here', bcrypt.gensalt(rounds=12)).decode())"
DASHBOARD_PASSWORD_HASH=

# Comma-separated list of origins allowed to call the API cross-origin.
# Leave empty for normal use — the dashboard only ever calls itself,
# same-origin, so this is defense-in-depth, not something you need to widen.
DASHBOARD_CORS_ORIGINS=https://mysafar-bot.bayanai.ir

# Host port docker-compose publishes (container always listens on 8765 internally).
HOST_PORT=8765
